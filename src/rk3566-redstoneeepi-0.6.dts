&dsi0 {
	status = "okay";

	panel@0 {
		compatible = "simple-panel-dsi";
		reg = <0>;
		status = "okay";

		backlight = <&sgm37604_bl>;
		power-supply = <&vcc_3v3>;
		reset-gpios = <&gpio3 RK_PD0 GPIO_ACTIVE_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&lcd_reset_pin>;

		prepare-delay-ms = <40>;
		reset-delay-ms = <60>;
		init-delay-ms = <80>;
		stbyb-delay-ms = <20>;
		enable-delay-ms = <60>;
		disable-delay-ms = <20>;
		unprepare-delay-ms = <20>;
		rotation = <90>;
		width-mm = <135>;
		height-mm = <216>;
		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
			      MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_CLOCK_NON_CONTINUOUS)>;
		dsi,format = <MIPI_DSI_FMT_RGB888>;
		dsi,lanes = <4>;
		panel-init-sequence = [05 78 01 11
				       05 0a 01 29];

		panel-exit-sequence = [05 10 01 28
				       05 78 01 10];

		disp_timings0: display-timings {
			native-mode = <&dsi_timing0>;

			dsi_timing0: timing0 {
				clock-frequency = <157000000>;
				hactive = <1080>;
				hfront-porch = <115>;
				hback-porch = <13>;
				hsync-len = <3>;
				vactive = <2160>;
				vfront-porch = <10>;
				vback-porch = <10>;
				vsync-len = <2>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				panel_in_dsi: endpoint {
					remote-endpoint = <&dsi_out_panel>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dsi_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi>;
			};
		};
	};
};
